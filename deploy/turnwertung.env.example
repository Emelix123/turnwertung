# Wird nach /etc/turnwertung/turnwertung.env kopiert (Rechte 0640, root:turnwertung).
# systemd liest die Datei ohne Shell: keine Anfuehrungszeichen, kein "export",
# alles hinter dem = ist Teil des Wertes.

# Admin-Passwort. UNBEDINGT aendern.
TW_ADMIN_PASSWORD=bitte-aendern

# Signiert das Admin-Cookie. Fest gesetzt, damit die Anmeldung einen Neustart
# ueberlebt. Neu erzeugen mit:  openssl rand -hex 32
TW_SECRET_KEY=bitte-erzeugen

# Nur lokal lauschen - erreichbar ist der Server ueber den ngrok-Tunnel.
# Auf 0.0.0.0 stellen, wenn zusaetzlich das Hallen-WLAN direkt zugreifen soll
# (dann Firewall pruefen: sudo ufw allow 8000/tcp).
TW_HOST=127.0.0.1
TW_PORT=8000

# Kein Autoreload im Betrieb: der Reloader startet einen zweiten Prozess und
# wuerfe bei jeder Dateiaenderung mitten im Wettkampf alle Verbindungen weg.
TW_RELOAD=0

# Datenbank ausserhalb des Codeverzeichnisses, damit ein Update sie nicht anfasst.
TW_DATA_DIR=/var/lib/turnwertung

# Startwert neuer Uebungen: 0 = reine E-Wertung, 10.0 = Notenmodus.
TW_DEFAULT_START_VALUE=0.0

# Gueltigkeit der Admin-Anmeldung in Sekunden (12 Stunden).
TW_ADMIN_SESSION_TTL=43200
